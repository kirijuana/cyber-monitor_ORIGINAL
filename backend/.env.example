# ===== Backend (Fastify) =====
PORT=8090
HOST=0.0.0.0

# Auth (JWT). ОБЯЗАТЕЛЬНО смените в продакшене!
JWT_SECRET=change-me-please
ADMIN_PASSWORD=admin
VIEWER_PASSWORD=viewer

# Dr.Web adapter: mock | live
DRWEB_MODE=mock
DRWEB_TLS_INSECURE=true
# Параметры реального Dr.Web Enterprise Server (только для DRWEB_MODE=live):
# API: http://<host>:9080 или https://<host>:9081
DRWEB_BASE_URL=http://localhost:9080
DRWEB_USERNAME=monitor
DRWEB_PASSWORD=

# Будущие источники (пусто => адаптер вернёт "unconfigured", UI покажет честный статус)
BITRIX24_WEBHOOK_URL=
MAIL_HOST=
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
